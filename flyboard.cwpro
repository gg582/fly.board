{
  "format": "cwist-project/v1",
  "name": "flyboard",
  "version": "1.0.0",
  "language": "c",
  "entrypoint": "src/main.c",
  "build": {
    "command": "make -j fly_board",
    "binary": "fly_board"
  },
  "dev": {
    "command": "./fly_board",
    "debounce_ms": 200,
    "stop_timeout_ms": 5000
  },
  "watch": {
    "exclude": [
      "data",
      "posts",
      "img",
      "third_party",
      "wasm",
      "wasm-client",
      "build-wasm",
      "tests",
      "tools"
    ]
  },
  "dependencies": {
    "cwist": ">=3.7.1"
  },
  "openapi": {
    "source": "src",
    "output": "openapi.json",
    "title": "fly.board",
    "version": "1.0.0"
  }
}
