// test_fly_board.c
// Unit tests for the keep-alive routing fix in fly.board.c
#include <assert.h>
#include <stdio.h>
#include <string.h>

/* Pull the whole unit under test into this translation unit so we can
 * exercise its static helpers directly. */
#include "fly.board.c"

/* Minimal concrete route table used by the stubs below. */
struct route {
    const char *path;
};

static const struct route routes[] = {
    { "/" },
    { "/slug" },
    { "/slug2" },
};

const struct route *route_lookup(const char *path)
{
    size_t i;
    for (i = 0; i < sizeof(routes) / sizeof(routes[0]); ++i) {
        if (strcmp(path, routes[i].path) == 0)
            return &routes[i];
    }
    return NULL;
}

/* Test fixtures: fake HTTP request feed and response log. */
static const char **feed_paths = NULL;
static int feed_pos = 0;

static const char *served[16];
static int served_count = 0;

static char status_bufs[16][32];
static int status_count = 0;

static void reset_fixture(void)
{
    feed_paths = NULL;
    feed_pos = 0;
    served_count = 0;
    status_count = 0;
}

int http_read_request(struct connection *conn, struct request *req)
{
    const char *next = feed_paths[feed_pos++];
    if (!next)
        return 0;
    strncpy(req->path, next, sizeof(req->path) - 1);
    req->path[sizeof(req->path) - 1] = '\0';
    req->keep_alive = (feed_paths[feed_pos] != NULL);
    (void)conn;
    return 1;
}

void http_send_status(struct connection *conn, int status)
{
    int idx = status_count++;
    snprintf(status_bufs[idx], sizeof(status_bufs[idx]), "status:%d", status);
    served[served_count++] = status_bufs[idx];
    (void)conn;
}

void serve_route(struct connection *conn, const struct route *route)
{
    served[served_count++] = route->path;
    (void)conn;
}

/* ------------------------------------------------------------------ */
/* Test cases                                                           */
/* ------------------------------------------------------------------ */

static void test_request_reset_zeroes_state(void)
{
    struct request req;
    strcpy(req.path, "/something");
    req.keep_alive = 1;
    request_reset(&req);
    assert(req.path[0] == '\0');
    assert(req.keep_alive == 0);
}

static void test_route_resolve_only_accepts_absolute_paths(void)
{
    assert(route_resolve(NULL) == NULL);
    assert(route_resolve("") == NULL);
    assert(route_resolve("relative") == NULL);
    assert(route_resolve("/") != NULL);
    assert(route_resolve("/slug") != NULL);
    assert(route_resolve("/missing") == NULL);
}

static void run_server_scenario(void)
{
    struct connection conn = { .fd = -1 };
    connection_serve(&conn);
}

static void test_root_then_slug_keepalive(void)
{
    reset_fixture();
    static const char *paths[] = { "/", "/slug", NULL };
    feed_paths = paths;

    run_server_scenario();

    assert(served_count == 2);
    assert(strcmp(served[0], "/") == 0);
    assert(strcmp(served[1], "/slug") == 0);
    printf("ok: root then slug on same connection\n");
}

static void test_slug_twice_no_drift(void)
{
    reset_fixture();
    static const char *paths[] = { "/slug", "/slug", NULL };
    feed_paths = paths;

    run_server_scenario();

    assert(served_count == 2);
    assert(strcmp(served[0], "/slug") == 0);
    assert(strcmp(served[1], "/slug") == 0);
    printf("ok: repeated slug does not drift\n");
}

static void test_404_then_real_route(void)
{
    reset_fixture();
    static const char *paths[] = { "/missing", "/slug", NULL };
    feed_paths = paths;

    run_server_scenario();

    assert(served_count == 2);
    assert(strncmp(served[0], "status:404", 10) == 0);
    assert(strcmp(served[1], "/slug") == 0);
    printf("ok: missing route returns 404, next route still works\n");
}

static void test_non_absolute_path_returns_404(void)
{
    reset_fixture();
    static const char *paths[] = { "slug", NULL };
    feed_paths = paths;

    run_server_scenario();

    assert(served_count == 1);
    assert(strncmp(served[0], "status:404", 10) == 0);
    printf("ok: non-absolute path returns 404\n");
}

static void test_non_keepalive_ends_loop(void)
{
    reset_fixture();
    static const char *paths[] = { "/slug", NULL };
    feed_paths = paths;

    run_server_scenario();

    assert(served_count == 1);
    assert(strcmp(served[0], "/slug") == 0);
    printf("ok: non-keepalive request ends loop\n");
}

int main(void)
{
    test_request_reset_zeroes_state();
    test_route_resolve_only_accepts_absolute_paths();
    test_root_then_slug_keepalive();
    test_slug_twice_no_drift();
    test_404_then_real_route();
    test_non_absolute_path_returns_404();
    test_non_keepalive_ends_loop();
    printf("all tests passed\n");
    return 0;
}