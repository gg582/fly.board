// test_fly_board.c
#include <assert.h>
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* Pull in the unit under test (and its static helpers). */
#include "fly.board.c"

/* ----- Minimal in-memory collaborators ----- */

struct route {
    const char *path;
};

static const struct route routes[] = {
    { "/" },
    { "/slug" },
    { "/other" },
};

const struct route *route_lookup(const char *path)
{
    size_t i;
    for (i = 0; i < sizeof(routes) / sizeof(routes[0]); ++i) {
        if (strcmp(path, routes[i].path) == 0)
            return &routes[i];
    }
    return NULL;
}

/* Request feed: each string is the next path read on the connection.
   A NULL sentinel ends the sequence. */
static const char *feed[16];
static size_t feed_pos = 0;

int http_read_request(struct connection *conn, struct request *req)
{
    const char *next = feed[feed_pos++];
    if (!next)
        return 0;
    strncpy(req->path, next, sizeof(req->path) - 1);
    req->path[sizeof(req->path) - 1] = '\0';
    req->keep_alive = (feed[feed_pos] != NULL);
    (void)conn;
    return 1;
}

/* Record of observed outcomes. */
static const char *served[32];
static int served_count = 0;

void http_send_status(struct connection *conn, int status)
{
    static char buf[32];
    snprintf(buf, sizeof(buf), "status:%d", status);
    served[served_count++] = buf;
    (void)conn;
}

void serve_route(struct connection *conn, const struct route *route)
{
    served[served_count++] = route->path;
    (void)conn;
}

/* ----- Helpers ----- */

static void reset_feed(const char *first, ...)
{
    va_list ap;
    size_t i = 0;
    feed_pos = 0;
    served_count = 0;

    if (first) {
        feed[i++] = first;
        va_start(ap, first);
        while (i < sizeof(feed) / sizeof(feed[0]) - 1) {
            const char *p = va_arg(ap, const char *);
            feed[i++] = p;
            if (!p)
                break;
        }
        va_end(ap);
    }
    feed[i] = NULL;
}

static int check_served(size_t count, ...)
{
    va_list ap;
    size_t i;
    if ((size_t)served_count != count)
        return 0;
    va_start(ap, count);
    for (i = 0; i < count; ++i) {
        const char *expected = va_arg(ap, const char *);
        if (strcmp(served[i], expected) != 0)
            return 0;
    }
    va_end(ap);
    return 1;
}

/* ----- Tests ----- */

static int test_root_then_slug_on_keepalive(void)
{
    struct connection conn = { .fd = -1 };
    reset_feed("/", "/slug", NULL);
    connection_serve(&conn);
    return check_served(2, "/", "/slug");
}

static int test_slug_then_root_on_keepalive(void)
{
    struct connection conn = { .fd = -1 };
    reset_feed("/slug", "/", NULL);
    connection_serve(&conn);
    return check_served(2, "/slug", "/");
}

static int test_reject_non_absolute_path(void)
{
    struct connection conn = { .fd = -1 };
    reset_feed("slug", NULL);
    connection_serve(&conn);
    return check_served(1, "status:404");
}

static int test_resolve_helper(void)
{
    return route_resolve("/") == route_lookup("/")
        && route_resolve("/slug") == route_lookup("/slug")
        && route_resolve("bad") == NULL
        && route_resolve("") == NULL
        && route_resolve(NULL) == NULL;
}

static int test_request_reset_clears_path(void)
{
    struct request req;
    strcpy(req.path, "/something");
    req.keep_alive = 1;
    request_reset(&req);
    return req.path[0] == '\0' && req.keep_alive == 0;
}

int main(void)
{
    int failed = 0;

    if (!test_root_then_slug_on_keepalive()) {
        fprintf(stderr, "FAILED: test_root_then_slug_on_keepalive\n");
        failed = 1;
    }
    if (!test_slug_then_root_on_keepalive()) {
        fprintf(stderr, "FAILED: test_slug_then_root_on_keepalive\n");
        failed = 1;
    }
    if (!test_reject_non_absolute_path()) {
        fprintf(stderr, "FAILED: test_reject_non_absolute_path\n");
        failed = 1;
    }
    if (!test_resolve_helper()) {
        fprintf(stderr, "FAILED: test_resolve_helper\n");
        failed = 1;
    }
    if (!test_request_reset_clears_path()) {
        fprintf(stderr, "FAILED: test_request_reset_clears_path\n");
        failed = 1;
    }

    if (failed) {
        return 1;
    }
    printf("ok: all fly.board routing tests passed\n");
    return 0;
}