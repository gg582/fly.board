# fly.board mail stack — Postfix main.cf additions for oborona.zip
# Install: append to /etc/postfix/main.cf (see deploy/mail/install.sh).

# --- Identity -------------------------------------------------------------
myhostname = mail.oborona.zip
mydomain = oborona.zip
myorigin = $mydomain
inet_interfaces = all
inet_protocols = all
mynetworks = 127.0.0.0/8

# --- Local users are virtual; recipient validation happens against the
# virtual mailbox map (one entry per user, rebuilt by mail-alias-build), and
# delivery goes through the pipe transport that runs mail-import (see the
# master.cf snippet in install.sh), which stores the message in the webmail DB
# and in the recipient's Maildir.
virtual_mailbox_domains = oborona.zip
virtual_mailbox_maps = hash:/etc/postfix/fly_mailboxes
virtual_alias_domains = oborona.zip
virtual_alias_maps = hash:/etc/postfix/fly_aliases
virtual_transport = fly-mail

# --- Inbound restrictions: relay only for localhost (the web server submits
# outbound mail on 127.0.0.1:25); everyone else may only reach local users.
smtpd_recipient_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_restriction_classes =

# --- Outbound relay: LEFT EMPTY ON PURPOSE.
# Port 25 to the outside world is often blocked (and many providers filter
# it), so by default Postfix tries direct MX delivery. If you want delivery
# through a relay (e.g. an SMTP relay on a non-standard port), set:
#   relayhost = [relay.example.com]:587
# and if the relay needs authentication also configure smtp_sasl_* settings.
relayhost =

# --- DKIM milter (opendkim on TCP 8891, see opendkim.conf) ----------------
# Uncomment after OpenDKIM is set up and its DNS TXT record is live:
#milter_default_action = accept
#milter_protocol = 6
#smtpd_milters = inet:localhost:8891
#non_smtpd_milters = inet:localhost:8891

# --- Misc hygiene ----------------------------------------------------------
message_size_limit = 52428800
smtpd_banner = $myhostname ESMTP
disable_vrfy_command = yes
